---
import SearchButton from "./SearchButton.tsx";

const currentYear = new Date().getFullYear();
---

<footer class="mt-16 pt-8 border-t border-[--color-border]">
    <nav
        aria-label="Footer"
        class="grid grid-cols-2 sm:grid-cols-3 gap-8 mb-10"
    >
        <div>
            <h3 class="font-semibold text-sm mb-3">Documentation</h3>
            <ul class="space-y-2 text-sm text-black/60">
                <li>
                    <a href="/docs" class="hover:text-black transition-colors"
                        >Getting Started</a
                    >
                </li>
                <li>
                    <a
                        href="/llms.txt"
                        target="_self"
                        class="hover:text-black transition-colors">llms.txt</a
                    >
                </li>
                <li>
                    <a
                        href="/llms-full.txt"
                        target="_self"
                        class="hover:text-black transition-colors"
                        >llms-full.txt</a
                    >
                </li>
            </ul>
        </div>

        <div>
            <h3 class="font-semibold text-sm mb-3">Resources</h3>
            <ul class="space-y-2 text-sm text-black/60">
                <li>
                    <a
                        href="https://github.com/hectoday/http"
                        rel="noopener noreferrer"
                        class="hover:text-black transition-colors">GitHub</a
                    >
                </li>
                <li>
                    <a
                        href="https://jsr.io/@hectoday/http"
                        rel="noopener noreferrer"
                        class="hover:text-black transition-colors">JSR</a
                    >
                </li>
            </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
            <h3 class="font-semibold text-sm mb-3">Quick Actions</h3>
            <ul class="space-y-2 text-sm text-black/60">
                <li>
                    <SearchButton client:only="react" />
                </li>
                <li class="mt-auto">
                    <a href="#top" class="hover:text-black transition-colors"
                        >Back to top ⤴</a
                    >
                </li>
            </ul>
        </div>
    </nav>

    <div
        class="pt-6 border-t border-[--color-border] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm text-black/60"
    >
        <p>
            <span aria-label="Copyright">&copy;</span>
            {currentYear} Hectoday. MIT License.
        </p>
    </div>
</footer>
