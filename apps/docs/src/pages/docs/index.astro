---
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import DocsList from "~/components/DocsList.tsx";

const isDev = import.meta.env.DEV;

const docs = await getCollection("docs");

// Separate helpers from main docs
const mainDocs = docs
    .filter((doc) => !doc.id.startsWith("helpers/"))
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const helperDocs = docs
    .filter((doc) => doc.id.startsWith("helpers/"))
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Documentation - @hectoday/http">
    <nav class="mb-8">
        <a href="/" class="hover:opacity-60 transition-opacity">← Home</a>
    </nav>

    <DocsList client:load docs={mainDocs} helpers={helperDocs} isDev={isDev} />
</Layout>
