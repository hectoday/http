{
  "$schema": "https://raw.githubusercontent.com/shikijs/shiki/main/packages/shiki/themes.schema.json",
  "name": "Hectoday Light",
  "displayName": "Hectoday Light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#242529",
    "editor.lineHighlightBackground": "#ebebecbf",
    "editor.selectionBackground": "#5c78e23d",
    "editorCursor.foreground": "#5c78e2",
    "editorLineNumber.foreground": "#b4b4bb",
    "editorLineNumber.activeForeground": "#44454b",
    "editorWhitespace.foreground": "#a3a3a4",
    "editorIndentGuide.background": "#383a410d",
    "editorIndentGuide.activeBackground": "#383a411a",
    "focusBorder": "#7d82e8",
    "activityBar.background": "#dcdcdd",
    "sideBar.background": "#ebebec",
    "statusBar.background": "#dcdcdd",
    "tab.activeBackground": "#fafafa",
    "tab.inactiveBackground": "#ebebec"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#3A3A3A",
        "background": "#FFF1B8"
      }
    },
    {
      "name": "Doc Comment",
      "scope": ["comment.block.documentation", "comment.block.javadoc"],
      "settings": {
        "foreground": "#3A3A3A",
        "background": "#FFF1B8"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#1E9F73"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "string.escape", "string.regexp"],
      "settings": {
        "foreground": "#4FAF8B"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#4FAF8B"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#273A72"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.method-call entity.name.function"
      ],
      "settings": {
        "foreground": "#FE3702",
        "background": "#FE370210"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#5B3FA6"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#0B0B0B"
      }
    },
    {
      "name": "Variable Special (this, self)",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2B2B2B"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Punctuation Brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.brackets",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6A6A6A"
      }
    },
    {
      "name": "Punctuation Delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.separator"
      ],
      "settings": {
        "foreground": "#6A6A6A"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#1F1F1F"
      }
    },
    {
      "name": "Tag Doctype",
      "scope": ["meta.tag.sgml.doctype", "entity.name.tag.doctype"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Constructor",
      "scope": ["entity.name.function.constructor", "meta.class.constructor"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Enum",
      "scope": ["entity.name.type.enum", "variable.other.enummember"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Embedded",
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Markdown Title",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#3A3A3A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Strong",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#3A3A3A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": ["string.other.link", "markup.underline.link"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Markdown List Marker",
      "scope": ["punctuation.definition.list", "markup.list"],
      "settings": {
        "foreground": "#6A6A6A"
      }
    },
    {
      "name": "Support",
      "scope": ["support.constant", "support.variable"],
      "settings": {
        "foreground": "#3A3A3A"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#d36151"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#a48819"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#FE3702",
    "function.declaration": "#FE3702",
    "method": "#FE3702",
    "method.declaration": "#FE3702",
    "type": "#5B3FA6",
    "class": "#5B3FA6",
    "interface": "#5B3FA6",
    "enum": "#3A3A3A",
    "enumMember": "#3A3A3A",
    "variable": "#0B0B0B",
    "variable.readonly": "#0B0B0B",
    "parameter": "#0B0B0B",
    "property": "#2B2B2B",
    "keyword": "#273A72",
    "string": "#1E9F73",
    "number": "#3A3A3A",
    "regexp": "#4FAF8B",
    "operator": "#3A3A3A",
    "comment": "#3A3A3A"
  }
}
