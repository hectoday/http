{
  "name": "@hectoday/convex",
  "version": "0.1.0",
  "description": "Run a @hectoday/http app as a Convex HTTP router, with the Convex ActionCtx exposed as c.env.",
  "keywords": [
    "convex",
    "hectoday",
    "http",
    "router",
    "serverless",
    "web-standards"
  ],
  "homepage": "https://github.com/hectoday/http#readme",
  "bugs": {
    "url": "https://github.com/hectoday/http/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hectoday/http.git",
    "directory": "packages/convex"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@hectoday/http": "^0.3.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "convex": "^1.17.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "peerDependencies": {
    "@hectoday/http": "^0.3.0",
    "convex": ">=1.16.0"
  }
}
