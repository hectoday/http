{
  "name": "@hectoday/http",
  "version": "0.1.4",
  "license": "MIT",
  "description": "A minimal, explicit web framework built on Web Standards with deterministic control flow and no magic responses",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-net",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  }
}
