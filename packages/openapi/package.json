{
  "name": "@hectoday/openapi",
  "version": "0.1.0",
  "description": "OpenAPI 3.1 spec generation for @hectoday/http routes.",
  "keywords": [
    "api",
    "documentation",
    "hectoday",
    "openapi",
    "spec",
    "swagger"
  ],
  "homepage": "https://github.com/hectoday/http#readme",
  "bugs": {
    "url": "https://github.com/hectoday/http/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hectoday/http.git",
    "directory": "packages/openapi"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@hectoday/http": "^0.2.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "typescript": "^5.9.3",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@hectoday/http": "^0.2.0",
    "zod": "^3.25.0"
  }
}
